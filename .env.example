# Required — free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- Everything below is optional; defaults suit local development ---

# LLM
# MODEL_NAME=llama-3.1-8b-instant
# LLM_TEMPERATURE=0            # 0 keeps SQL deterministic, which makes caching work
# MAX_SQL_RETRIES=2            # correction turns after a failed query; 0 disables

# Query execution
# MAX_RESULT_ROWS=100          # cap enforced inside DuckDB, not after fetching
# QUERY_TIMEOUT_SECONDS=30
# DUCKDB_MEMORY_LIMIT=2GB
# DUCKDB_THREADS=4

# Response cache
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=86400

# Rate limiting — off locally, on for the hosted demo
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_PER_HOUR=20
# RATE_LIMIT_GLOBAL_PER_DAY=1000

# HTTP
# CORS_ORIGINS=http://localhost:3000
# LOG_LEVEL=INFO

# Data
# TAXI_DATA_PATH=backend/data/yellow_tripdata_2024-*.parquet
# HISTORY_DB_PATH=backend/data/history.db
# SAMPLE_DATA_URL=            # deploy only: URL of a prebuilt taxi_sample.parquet
# SAMPLE_ROWS=1000000         # deploy only: rows to sample if one must be built
